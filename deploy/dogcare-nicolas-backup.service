[Unit]
Description=Private nicolasdelalaissedogcare SQLite and audio backup

[Service]
Type=oneshot
User=dogcare-nicolas
Group=dogcare-nicolas
WorkingDirectory=/opt/dogcare/current
ExecStart=/usr/bin/python3 scripts/private_backup.py backup --data-dir /var/lib/dogcare-nicolas --backup-dir /var/lib/dogcare-nicolas/backups --keep 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dogcare-nicolas
