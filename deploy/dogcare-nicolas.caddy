# Second instance (Nicolas). Dedicated site: retain same-origin microphone, camera and geolocation permissions.
nicolasdelalaissedogcare.plusdefun.ch {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=()"
    }
    reverse_proxy 127.0.0.1:18848 {
        header_up X-DogCare-Client-IP {http.request.remote.host}
    }
}
