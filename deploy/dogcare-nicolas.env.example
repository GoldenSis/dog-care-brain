# Second instance. Copy privately to /etc/dogcare-nicolas.env, root:root 0600. Never commit real secrets.
DC_HOST=127.0.0.1
DC_PORT=18848
DC_TRUSTED_PROXY=127.0.0.1
DC_ROOT=/opt/dogcare/current
DC_DATA_DIR=/var/lib/dogcare-nicolas
DC_INSECURE_COOKIE=0
DC_AUTH_MODE=smtp
DC_PUBLIC_ORIGIN=https://nicolasdelalaissedogcare.plusdefun.ch
DC_SMTP_HOST=mail.infomaniak.com
DC_SMTP_PORT=2525
DC_SMTP_TLS=starttls
DC_SMTP_USER=REPLACE_WITH_AUTHORIZED_MAILBOX
DC_SMTP_PASSWORD=REPLACE_PRIVATELY
DC_SMTP_FROM="La Laisse Dog Walker by Plus de Fun <REPLACE_WITH_AUTHORIZED_MAILBOX>"
# Brand: any name other than "Le Bus des Toutous" hides Adine-Sophie's gallery, photos and films.
# Public presentation only; keep data, public origin and SMTP From configured separately. See docs/second-instance.md.
# The web address and instance id stay nicolasdelalaissedogcare; only the displayed business changes.
DC_BRAND_NAME="La Laisse Dog Walker"
# Short form for the phone header; titles, emails and GPX keep the full name.
DC_BRAND_SHORT="La Laisse"
DC_BRAND_OWNER="Nicolás"
DC_BRAND_TAGLINE="Promenades canines · Batignolles · depuis 2011"
DC_BRAND_INSTAGRAM=lalaisse.dogwalker
# Original dog-head silhouette. Once Nicolas sends his logo file and permission, set DC_BRAND_LOGO
# to a PNG/JPEG/WebP outside the release (readable by dogcare-nicolas); it replaces the mark.
DC_BRAND_MARK=dog
# DC_BRAND_LOGO=/var/lib/dogcare-nicolas/brand/logo.png
# His services, about, contact and gallery copy. Read on each page load; no restart needed after edits.
DC_BRAND_CONTENT=/opt/dogcare/current/deploy/dogcare-nicolas.content.json
# Black and white like his wordmark, with one accent: Sol de Mayo gold, a nod to his Argentine roots.
# Gold primary carries near-black text (9.5:1); near-black links and decoration on white (17.4:1).
# Primary and dark must both be six-digit hex colours; missing/invalid secondary falls back to dark.
DC_BRAND_PRIMARY="#F6B40E"
DC_BRAND_DARK="#1A1A1A"
DC_BRAND_SECONDARY="#1A1A1A"
# Set after owner bootstrap.
# DC_PUBLIC_BUSINESS=REPLACE_WITH_BUSINESS_ID
# Never enable DC_ALLOW_DEMO_SIGNUP or development auth on this service.
