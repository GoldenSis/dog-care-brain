[Unit]
Description=nicolasdelalaissedogcare by Plus de Fun (second Dogcare instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dogcare-nicolas
Group=dogcare-nicolas
WorkingDirectory=/opt/dogcare/current
EnvironmentFile=/etc/dogcare-nicolas.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 scripts/check_media_runtime.py --directory /var/lib/dogcare-nicolas
ExecStart=/usr/bin/python3 api/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dogcare-nicolas

[Install]
WantedBy=multi-user.target
