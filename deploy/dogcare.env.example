# Copy privately to /etc/dogcare.env, root:root 0600. Never commit real secrets.
DC_HOST=127.0.0.1
DC_PORT=18847
DC_ROOT=/opt/dogcare/current
DC_DATA_DIR=/var/lib/dogcare
DC_INSECURE_COOKIE=0
DC_AUTH_MODE=smtp
DC_PUBLIC_ORIGIN=https://dogcare.plusdefun.ch
DC_SMTP_HOST=mail.infomaniak.com
DC_SMTP_PORT=2525
DC_SMTP_TLS=starttls
DC_SMTP_USER=REPLACE_WITH_AUTHORIZED_MAILBOX
DC_SMTP_PASSWORD=REPLACE_PRIVATELY
DC_SMTP_FROM="Le Bus des Toutous by Plus de Fun <REPLACE_WITH_AUTHORIZED_MAILBOX>"
# Set after owner bootstrap for selected public artwork and configured service rates.
# DC_PUBLIC_BUSINESS=REPLACE_WITH_BUSINESS_ID
# Never enable DC_ALLOW_DEMO_SIGNUP or development auth on this service.
