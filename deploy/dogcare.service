[Unit]
Description=Le Bus des Toutous by Plus de Fun
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dogcare
Group=dogcare
WorkingDirectory=/opt/dogcare/current
EnvironmentFile=/etc/dogcare.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 scripts/check_media_runtime.py --directory /var/lib/dogcare
ExecStart=/usr/bin/python3 api/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dogcare

[Install]
WantedBy=multi-user.target
